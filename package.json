{
  "name": "nexa-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Nexa event vendor marketplace — one API server, three separate apps (customer, vendor Business Studio, admin console). Powered by ERA.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "api-server",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:customer": "npm run dev --workspace apps/customer",
    "dev:studio": "npm run dev --workspace apps/studio",
    "dev:admin": "npm run dev --workspace apps/admin",
    "dev:api": "npm run dev --workspace api-server",
    "db:types": "npm run db:types --workspace packages/db-types",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}

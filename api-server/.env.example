PORT=4000

# Same Supabase project every app in the monorepo uses.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated frontend origins allowed to call this server.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Outbound WhatsApp notifications (vendor "new booking" ping, customer "offer
# accept" button). Leave unset to no-op — nothing else here depends on it.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=nexa_new_message
WHATSAPP_TEMPLATE_LANG=en
